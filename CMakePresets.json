{
  "version": 6,
  "configurePresets": [
    {
      "name": "f407-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "f407-debug",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_ENABLE_USB_CDC": false,
        "PNX_ENABLE_PWM_A2": false
      }
    },
    {
      "name": "f407-release",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_ENABLE_USB_CDC": false,
        "PNX_ENABLE_PWM_A2": false
      }
    },
    {
      "name": "f407-usb-cdc-debug",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_ENABLE_USB_CDC": true,
        "PNX_ENABLE_PWM_A2": false
      }
    },
    {
      "name": "f407-usb-cdc-release",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_ENABLE_USB_CDC": true,
        "PNX_ENABLE_PWM_A2": false
      }
    },
    {
      "name": "f407-pwm-a2-debug",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_ENABLE_USB_CDC": false,
        "PNX_ENABLE_PWM_A2": true
      }
    },
    {
      "name": "f407-ps2-debug",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_ENABLE_USB_CDC": false,
        "PNX_ENABLE_PWM_A2": false,
        "PNX_ENABLE_PS2_VALIDATION": true,
        "PNX_BOARD_PARAMS": "${sourceDir}/configs/boards/dji_c_board_f407/params.ps2.json"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "f407-debug",
      "configurePreset": "f407-debug"
    },
    {
      "name": "f407-release",
      "configurePreset": "f407-release"
    },
    {
      "name": "f407-usb-cdc-debug",
      "configurePreset": "f407-usb-cdc-debug"
    },
    {
      "name": "f407-usb-cdc-release",
      "configurePreset": "f407-usb-cdc-release"
    },
    {
      "name": "f407-pwm-a2-debug",
      "configurePreset": "f407-pwm-a2-debug"
    },
    {
      "name": "f407-ps2-debug",
      "configurePreset": "f407-ps2-debug"
    }
  ]
}
