# DMIMU 协议参数。
config_integer(_dm_id 0 255 dmimu can_id)
config_integer(_dm_master 0 255 dmimu master_id)
config_integer(_dm_window 1 2147483647 dmimu assembly_timeout_ms)
config_integer(_dm_offline 1 2147483647 dmimu offline_timeout_ms)
string(JSON _dm_mode GET "${_json}" dmimu mode)
if(NOT _dm_mode MATCHES "^(active|request)$" OR _dm_window GREATER _dm_offline)
    message(FATAL_ERROR "dmimu: mode must be active/request; assembly timeout must not exceed offline timeout")
endif()

# AHRS 线程、采样与恢复策略。
config_integer(_ahrs_priority 0 31 ahrs thread_priority)
config_integer(_ahrs_period 1 2147483647 ahrs sample_period_ticks)
config_float(_ahrs_max_dt 0.000001 1 ahrs max_dt)
config_integer(_ahrs_retry 1 2147483647 ahrs retry_period_ms)
config_integer(_ahrs_warmup 1 2147483647 ahrs warmup_timeout_ms)
config_bool(_ahrs_calibrate ahrs calibrate_on_start)
config_integer(_ahrs_wait 1 2147483647 ahrs dmimu_wait_ticks)
config_integer(_ahrs_request 1 2147483647 ahrs dmimu_request_period_ms)
config_integer(_ahrs_queue 4 256 ahrs dmimu_queue_frames)
config_integer(_ahrs_bmi088_stack 2048 32768 ahrs bmi088_stack_size)
config_integer(_ahrs_dmimu_stack 1024 16384 ahrs dmimu_stack_size)

# BMI088 温控；当前 PID 参数对应固定 125 ms 控制周期。
foreach(_parameter IN ITEMS period_ms timeout_ms stable_time_ms)
    config_integer(_heater_${_parameter} 1 60000 bmi088_heater ${_parameter})
endforeach()
config_integer(_heater_priority 1 31 bmi088_heater thread_priority)
config_integer(_heater_stack 1024 16384 bmi088_heater stack_size)
config_float(_heater_tolerance 0.01 5 bmi088_heater stable_tolerance)
if(NOT _heater_period_ms EQUAL 125)
    message(FATAL_ERROR "BMI088 PID requires bmi088_heater.period_ms = 125")
endif()
if(_heater_timeout_ms LESS_EQUAL _heater_period_ms)
    message(FATAL_ERROR "Heater requires period_ms < timeout_ms")
endif()

# ESKF 参数及传感器零偏。
config_float(_eskf_gyro_noise 0.000000001 10000 ahrs eskf gyro_noise)
config_float(_eskf_gyro_bias_walk 0 10000 ahrs eskf gyro_bias_walk)
config_float(_eskf_accel_noise 0.000000001 10000 ahrs eskf accel_noise)
config_float(_eskf_accel_magnitude_gain 0 10000 ahrs eskf accel_magnitude_gain)
config_float(_eskf_nis_gate 0 10000 ahrs eskf nis_gate)
config_float(_eskf_reject_timeout 0 10000 ahrs eskf reject_timeout)
config_float(_eskf_impact_jerk 0.000000001 10000 ahrs eskf impact_jerk)
config_float(_eskf_impact_hold 0 10000 ahrs eskf impact_hold)
config_float(_eskf_static_accel_tolerance 0.000000001 10000 ahrs eskf static_accel_tolerance)
config_float(_eskf_static_gyro_tolerance 0.000000001 10000 ahrs eskf static_gyro_tolerance)
config_float(_eskf_static_filter_time_constant 0.000000001 10000 ahrs eskf static_filter_time_constant)
config_float(_eskf_zero_rate_min_time 0 10000 ahrs eskf zero_rate_min_time)
config_float(_eskf_initial_tilt_stddev 0.000000001 10000 ahrs eskf initial_tilt_stddev)
config_float(_eskf_initial_yaw_stddev 0.000000001 10000 ahrs eskf initial_yaw_stddev)
config_float(_eskf_initial_bias_stddev 0.000000001 10000 ahrs eskf initial_bias_stddev)
config_float(_eskf_min_bias_stddev 0.000000001 10000 ahrs eskf min_bias_stddev)
config_vector3(_gyro_offset ahrs gyro_offset)
config_vector3(_accel_offset ahrs accel_offset)
