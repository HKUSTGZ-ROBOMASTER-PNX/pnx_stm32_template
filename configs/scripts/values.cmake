# 从 _json 读取参数。调用格式：输出变量、取值范围（如有）、JSON 路径。
# integer 返回整数，float 返回带 f 后缀的 C++ 字面量，bool 返回 true/false。
function(config_number out min max)
    string(JSON value GET "${_json}" ${ARGN})
    string(JSON type TYPE "${_json}" ${ARGN})
    if(NOT type STREQUAL "NUMBER" OR value LESS min OR value GREATER max)
        message(FATAL_ERROR "${ARGN}: expected a number in [${min}, ${max}]")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(config_integer out min max)
    config_number(value ${min} ${max} ${ARGN})
    if(NOT value MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${ARGN}: expected an integer")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(config_bool out)
    string(JSON type TYPE "${_json}" ${ARGN})
    if(NOT type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "${ARGN}: expected a boolean")
    endif()
    string(JSON value GET "${_json}" ${ARGN})
    if(value)
        set(${out} true PARENT_SCOPE)
    else()
        set(${out} false PARENT_SCOPE)
    endif()
endfunction()

function(config_float out min max)
    config_number(value ${min} ${max} ${ARGN})
    if(NOT value MATCHES "[.eE]")
        string(APPEND value ".0")
    endif()
    set(${out} "${value}f" PARENT_SCOPE)
endfunction()

function(config_vector3 out)
    string(JSON type TYPE "${_json}" ${ARGN})
    if(NOT type STREQUAL "ARRAY")
        message(FATAL_ERROR "${ARGN}: expected an array of three coordinates")
    endif()
    string(JSON count LENGTH "${_json}" ${ARGN})
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "${ARGN}: expected an array of three coordinates")
    endif()
    foreach(axis RANGE 0 2)
        config_float(component_${axis} -100 100 ${ARGN} ${axis})
    endforeach()
    set(${out} "${component_0}, ${component_1}, ${component_2}" PARENT_SCOPE)
endfunction()
